<?xml version="1.0" encoding="UTF-8"?>
<project name="SistemaVenta" default="default" basedir=".">
    <description>Builds, tests, and runs the project SistemaVenta.</description>
    <import file="nbproject/build-impl.xml"/>
    
    <!-- ✅ Copiar imágenes dentro del JAR al compilar -->
    <target name="-post-compile">
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}">
                <include name="**/*.png"/>
                <include name="**/*.jpg"/>
                <include name="**/*.jpeg"/>
                <include name="**/*.gif"/>
                <include name="**/*.ico"/>
                <include name="**/*.icns"/>
            </fileset>
        </copy>
    </target>
    
</project>